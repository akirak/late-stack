{
  "name": "personal-blog",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "wrangler dev --config .output/server/wrangler.json",
    "deploy": "wrangler deploy --config .output/server/wrangler.json",
    "typecheck": "tsgo --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "lint-staged": "lint-staged",
    "test-e2e": "pnpm exec playwright test",
    "test-e2e:chromium": "pnpm exec playwright test --project=chromium",
    "test-e2e-report": "pnpm exec playwright show-report",
    "test:http:feed": "node tests/http/feed.test.js",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.29",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.40",
    "browserslist": "^4.28.7",
    "effect": "^3.22.1",
    "expressive-code": "^0.44.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-rewriter-wasm": "^0.4.1",
    "lightningcss": "^1.33.0",
    "react": "19.2.7",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-expressive-code": "^0.44.1",
    "remark-captions": "^2.2.4",
    "remark-custom-header-id": "^1.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@effect/language-service": "^0.86.6",
    "@effect/platform": "^0.96.3",
    "@effect/platform-node": "^0.107.0",
    "@effect/sql": "^0.51.1",
    "@effect/sql-sqlite-node": "^0.52.0",
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@storybook/react-vite": "^10.5.7",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "13.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-xml-parser": "^5.10.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.1",
    "reading-time": "^1.5.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "storybook": "^10.5.7",
    "tsx": "^4.23.11",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,yaml}": [
      "eslint --fix"
    ]
  }
}
